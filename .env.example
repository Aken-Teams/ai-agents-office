# Server
PORT=12054
JWT_SECRET=change-this-to-a-secure-random-string
NODE_ENV=development

# CORS (comma-separated origins, defaults to localhost:PORT-1 and localhost:PORT)
# CORS_ORIGINS=http://localhost:12053,http://localhost:12054

# API URL for Next.js proxy (defaults to http://localhost:PORT)
# API_URL=http://localhost:12054

# Workspace (sandbox root for generated files)
WORKSPACE_ROOT=./workspace


# Claude CLI
CLAUDE_CLI_PATH=claude
# Anthropic API Key — fallback when account quota is exhausted
# Account auth is used by default; API key is only used when "hit your limit" is detected
ANTHROPIC_API_KEY=

# Deploy mode: pro-panjit (internal, uniform quota) | pro-out (external, per-user quota)
DEPLOY_MODE=pro-panjit

# Storage quota per user (GB)
STORAGE_QUOTA_GB=2

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=db_ai_agents
MYSQL_USER=root
MYSQL_PASSWORD=

# ----------------------------------------
# Resend 寄信設定 (HTTP API，不受 SMTP port 限制)
# ----------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_BCC=

DEEPSEEK_API_KEY=

Version=

AD_API_URL=
AD_API_KEY=your_api_key_here
EMAIL_LOGIN_WHITELIST=

# LINE Bot integration
# Set LINE_BOT_ENABLED=true to mount the /webhook/line endpoint and start the worker.
LINE_BOT_ENABLED=false
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Public base URL of this API (no trailing slash), e.g. https://agents.example.com
LINE_PUBLIC_API_BASE=
# LINE Official Account basic id (starts with @), used to build the QR deep link
LINE_BOT_BASIC_ID=
LINE_LIFF_ID=
LINE_RICH_MENU_ID=
# Runtime defaults (admin can override these live from the web UI)
LINE_DEFAULT_QUOTA_USD=5
LINE_MAX_MSG_PER_MIN=10
LINE_FILE_SHARE_TTL_DAYS=7
LINE_CONVERSATION_IDLE_HOURS=12

# Redis (required when LINE_BOT_ENABLED=true — backs the message queue)
REDIS_URL=redis://127.0.0.1:6379
