# Server
PORT=12054
JWT_SECRET=change-this-to-a-secure-random-string
NODE_ENV=development

# CORS (comma-separated origins, defaults to localhost:PORT-1 and localhost:PORT)
# CORS_ORIGINS=http://localhost:12053,http://localhost:12054

# API URL for Next.js proxy (defaults to http://localhost:PORT)
# API_URL=http://localhost:12054

# Workspace (sandbox root for generated files)
WORKSPACE_ROOT=./workspace

# Claude CLI
CLAUDE_CLI_PATH=claude
# Isolated CLI config dir (service-account auth via apiKeyHelper). Optional.
# AGENTS_OFFICE_CLAUDE_CONFIG_DIR=

# Agent engine for orchestrator router + worker agents: claude (default) | codex
AGENTS_OFFICE_AGENT_ENGINE=claude

# Codex CLI (only used when AGENTS_OFFICE_AGENT_ENGINE=codex). Requires `codex login`.
CODEX_CLI_PATH=codex
# CODEX_CLI_MODEL=
# CODEX_CLI_SANDBOX=workspace-write
# AGENTS_OFFICE_CODEX_HOME=

# Models for lightweight tool-free text (greeting + memory extraction), run via
# the Claude CLI — NOT the raw Claude API.
# CLAUDE_TEXT_GREETING_MODEL=claude-haiku-4-5
# CLAUDE_TEXT_EXTRACTION_MODEL=claude-haiku-4-5

# Deploy mode: pro-panjit (internal, uniform quota) | pro-out (external, per-user quota)
DEPLOY_MODE=pro-panjit

# Storage quota per user (GB)
STORAGE_QUOTA_GB=2

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=db_ai_agents
MYSQL_USER=root
MYSQL_PASSWORD=

# ----------------------------------------
# Resend 寄信設定 (HTTP API，不受 SMTP port 限制)
# ----------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_BCC=


DEEPSEEK_API_KEY=

# ----------------------------------------
# 地端 / 私有 OpenAI 相容 LLM (Ollama gateway 等)
# 與主 Claude CLI 協作：輕量任務走這（節省 token），重活走 Claude
# ----------------------------------------
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_DEFAULT_MODEL=
LOCAL_LLM_TIMEOUT_MS=120000
# Optional extra providers (JSON array, single line). Keyed by "name".
# Per-provider flags: thinking, minMaxTokens, forceNonStream, identityOverride.
# Example:
# LOCAL_LLM_PROVIDERS_JSON=[{"name":"deepseek","baseUrl":"https://example/v1","apiKey":"sk-...","model":"deepseek-v4-flash","thinking":true,"minMaxTokens":1500,"forceNonStream":true,"identityOverride":"You are ..."}]
LOCAL_LLM_PROVIDERS_JSON=
LOCAL_LLM_DEFAULT_PROVIDER=default

# Personal RAG hybrid search (LEANN-inspired vector + BM25 fusion).
#   RAG_VECTOR_WEIGHT     1.0 = pure semantic (HNSW), 0.0 = pure keyword (BM25). 0.7 default.
#   RAG_HYBRID_MIN_SCORE  post-fusion threshold (after min-max norm to [0,1]).
#   RAG_LRU_CAPACITY      in-memory cap for per-user HNSW + BM25 handles.
RAG_VECTOR_WEIGHT=0.7
RAG_HYBRID_MIN_SCORE=0.35
RAG_LRU_CAPACITY=50